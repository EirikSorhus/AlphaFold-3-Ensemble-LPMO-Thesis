{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "metrics.csv column spec",
  "description": "Flat table — one row per pose that passed QC.",
  "columns": [
    {"name": "run_id",             "type": "string",  "desc": "Unique run identifier"},
    {"name": "protein_id",         "type": "string",  "desc": "Protein identifier"},
    {"name": "protein_family",     "type": "string",  "desc": "AA family (AA9, AA10, …)"},
    {"name": "ligand_id",          "type": "string",  "desc": "Ligand identifier (polymer_type_dpN)"},
    {"name": "substrate_type",     "type": "string",  "desc": "chitin | cellulose | amylose"},
    {"name": "dp",                 "type": "integer", "desc": "Degree of polymerisation (2–8)"},
    {"name": "model",              "type": "string",  "desc": "AF3 | RF3 | Boltz2"},
    {"name": "seed",               "type": "integer", "desc": "Random seed used"},
    {"name": "pose_id",            "type": "string",  "desc": "Pose identifier"},
    {"name": "placer_rank",        "type": "integer", "desc": "PLACER rank within ensemble"},
    {"name": "placer_score",       "type": "float",   "desc": "PLACER score"},
    {"name": "posebusters_pass",   "type": "boolean", "desc": "PoseBusters hard pass?"},
    {"name": "posebusters_warnings","type": "string", "desc": "Comma-separated soft flags"},
    {"name": "privateer_pass",     "type": "boolean", "desc": "Privateer full pass?"},
    {"name": "cu_his_dist_mean_a", "type": "float",   "desc": "Mean Cu–His distance (Å)"},
    {"name": "cu_c1_dist_a",       "type": "float",   "desc": "Cu–C1 distance (Å)"},
    {"name": "cu_c4_dist_a",       "type": "float",   "desc": "Cu–C4 distance (Å)"},
    {"name": "his_brace_angle_deg","type": "float",   "desc": "His-brace tilt angle (°)"},
    {"name": "planarity_score",    "type": "float",   "desc": "Substrate ring planarity (0–1)"},
    {"name": "b_iso_mean",         "type": "float",   "desc": "Mean atom B_iso"},
    {"name": "residue_qa_median",  "type": "float",   "desc": "Residue-level QA median"},
    {"name": "cluster_id",         "type": "integer", "desc": "HDBSCAN cluster (-1 = outlier)"},
    {"name": "cluster_occupancy",  "type": "float",   "desc": "Occupancy of assigned cluster"},
    {"name": "dist_to_medoid",     "type": "float",   "desc": "Jaccard distance to cluster medoid"},
    {"name": "crystal_ifp_sim",    "type": "float",   "desc": "Tanimoto vs crystal IFP (null if N/A)"},
    {"name": "crystal_pocket_rmsd","type": "float",   "desc": "Pocket RMSD vs crystal (null if N/A)"},
    {"name": "mechanism_tag",      "type": "string",  "desc": "C1_like | C4_like | mixed | unknown"},
    {"name": "activity_class",     "type": "string",  "desc": "Annotated: C1 | C4 | mixed"},
    {"name": "cbm_present",        "type": "boolean", "desc": "True if DEL B (full-length)"},
    {"name": "cbm_ligand_dist_a",  "type": "float",   "desc": "CBM–ligand min dist (DEL B only)"},
    {"name": "cbm_cu_dist_a",      "type": "float",   "desc": "CBM–Cu min dist (DEL B only)"},
    {"name": "qc_soft_flags",      "type": "string",  "desc": "Pipe-separated soft flags"}
  ]
}
